#include <LiquidCrystal.h>
#include <Servo.h>

const int moisturePin = A5;
const int redLED = 8;
const int blueLED = 9;
const int greenLED = 13;
const int buzzerPin = 10;
const int buttonPin = A0;
const int servoPin = 7;

Servo myservo;
LiquidCrystal lcd(12, 11, 5, 4, 3, 2);
int contrast = 150;

void setup() {
  pinMode(redLED, OUTPUT);
  pinMode(greenLED, OUTPUT);
  pinMode(blueLED, OUTPUT);
  pinMode(buttonPin, INPUT_PULLUP);
  pinMode(buzzerPin, OUTPUT);
  
  myservo.attach(servoPin);
  myservo.write(0);
  
  //analogWrite(6, contrast); // Controls LCD contrast on Pin V0
  lcd.begin(16, 2);
}

void loop() {
  int moisture = analogRead(moisturePin);

  lcd.setCursor(0, 0);
  lcd.print("Moisture : ");
  lcd.print(moisture);
  lcd.print("   "); // Clears trailing digits when values change

  if (moisture < 300) {
    myservo.write(0);
    digitalWrite(redLED, HIGH);
    digitalWrite(greenLED, LOW);
    digitalWrite(blueLED, LOW);
    tone(buzzerPin, 1000);
    lcd.setCursor(0, 1);
    lcd.print("Status: Low    ");

    if (digitalRead(buttonPin) == LOW) {
      myservo.write(180);
      noTone(buzzerPin);
      delay(2000);
    }
  } 
  else if (moisture >= 300 && moisture < 700) {
    digitalWrite(redLED, LOW);
    digitalWrite(blueLED, HIGH);
    digitalWrite(greenLED, LOW);
    myservo.write(45);
    noTone(buzzerPin);
    lcd.setCursor(0, 1);
    lcd.print("Status: Medium ");
  } 
  else {
    myservo.write(0);
    digitalWrite(redLED, LOW);
    digitalWrite(blueLED, LOW);
    digitalWrite(greenLED, HIGH);
    noTone(buzzerPin);
    lcd.setCursor(0, 1);
    lcd.print("Status: High   ");
  }

  delay(100);
}
