void setup()
{
  pinMode(LED_BUILTIN, OUTPUT);
  String word = "HELLO"; 
  for(int i = 0; i < word.length(); i++)
  {
    blink_morse(word[i]); 
  }
}

void dot()
{
	digitalWrite(LED_BUILTIN, HIGH);
    delay(1000); 
    digitalWrite(LED_BUILTIN, LOW);
    delay(1000);
}

void dash()
{
  	digitalWrite(LED_BUILTIN, HIGH);
    delay(3000);
    digitalWrite(LED_BUILTIN, LOW);
  	delay(1000);
}
void blink_morse(char letter)
{
  if(letter == 'A')
  {
    dot();
    dash();
  } 
