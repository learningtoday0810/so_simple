#include <Keypad.h>
#include <LiquidCrystal.h>

// LCD: RS, E, D4, D5, D6, D7
LiquidCrystal lcd(13, A0, A1, A2, A3, A4);

// Keypad
const byte ROWS = 4;
const byte COLS = 4;

char keys[ROWS][COLS] = {
  {'1','2','3','A'},
  {'4','5','6','B'},
  {'7','8','9','C'},
  {'*','0','#','D'}
};

byte rowPins[ROWS] = {9, 8, 7, 6};
byte colPins[COLS] = {5, 4, 3, 2};

Keypad keypad = Keypad(
  makeKeymap(keys),
  rowPins,
  colPins,
  ROWS,
  COLS
);

// LEDs and buzzer
const int greenLED = 10;
const int redLED = 11;
const int buzzer = 12;

// Password
String password = "1234";
String entered = "";

int wrongAttempts = 0;

void setup() {

  pinMode(greenLED, OUTPUT);
  pinMode(redLED, OUTPUT);
  pinMode(buzzer, OUTPUT);

  lcd.begin(16, 2);

//  lcd.setCursor(0, 0);
//  lcd.print("YESHWANTH'S DOOR LOCK SYSTEM");

  delay(2000);
  lcd.print("HARAN IS GAY");

  delay(2000);

  lcd.clear();
  lcd.print("Enter Password:");
  lcd.setCursor(0, 1);
}

void loop() {

  char key = keypad.getKey();

  if (key) {

    // Clear password
    if (key == '*') {

      entered = "";

      lcd.clear();
      lcd.print("Enter Password:");
      lcd.setCursor(0, 1);
    }

    // Check password
    else if (key == '#') {

      if (entered == password) {

        // Correct
        lcd.clear();
        lcd.print("ACCESS GRANTED");

        wrongAttempts = 0;

        for (int i = 0; i < 3; i++) {
          digitalWrite(greenLED, HIGH);
          delay(300);
          digitalWrite(greenLED, LOW);
          delay(300);
        }

      } 
      else {

        // Wrong
        wrongAttempts++;

        lcd.clear();
        lcd.print("WRONG PASSWORD");

        digitalWrite(redLED, HIGH);
        delay(500);
        digitalWrite(redLED, LOW);

        delay(1000);

        // 3 wrong attempts
        if (wrongAttempts >= 3) {

          lcd.clear();
          lcd.print("SYSTEM LOCKED");
          lcd.setCursor(0, 1);
          lcd.print("Wait 10 seconds");

          digitalWrite(redLED, HIGH);

          tone(buzzer, 1000);
          delay(2000);
          noTone(buzzer);

          delay(8000);

          digitalWrite(redLED, LOW);

          wrongAttempts = 0;
        }
      }

      entered = "";

      delay(1000);

      lcd.clear();
      lcd.print("Enter Password:");
      lcd.setCursor(0, 1);
    }

    // Number keys
    else if (key >= '0' && key <= '9') {

      if (entered.length() < 4) {

        entered += key;

        // Display * instead of password
        lcd.print("*");
      }
    }
  }
}
